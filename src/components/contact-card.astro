---
import { Icon } from "astro-icon/components";
import { useTranslations } from "@/i18n/utils";
import { COMPANY, SOCIALS } from "@/config";

const lang = Astro.currentLocale ?? "fr";
const t = useTranslations(lang);

const inputClass =
  "w-full rounded-xl border border-transparent bg-blue-light-50 px-4 py-3 text-paragraph-sm text-neutral-dark-50 placeholder:text-neutral-dark-10/40 transition-colors focus:border-blue-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-50/20";

const infoItems = [
  { icon: "map-pin", value: COMPANY.address, href: undefined },
  { icon: "phone", value: COMPANY.phone, href: `tel:${COMPANY.phoneHref}` },
  { icon: "mail", value: COMPANY.email, href: `mailto:${COMPANY.email}` },
];

const socialBrandColor: Record<string, string> = {
  facebook: "#1877F2",
  linkedin: "#0A66C2",
  instagram: "#E1306C",
  x: "#0F1419",
  youtube: "#FF0000",
};

const socials = Object.entries(SOCIALS).filter(([, social]) => social.active);
---

<div
  class="relative overflow-hidden rounded-[2rem] bg-white p-6 font-poppins shadow-xl shadow-blue-10/10 sm:p-8 md:rounded-[2.5rem] md:p-12"
>
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <h1
        class="font-poppins text-3xl font-bold text-neutral-dark-10 md:text-heading-sm"
      >
        {t("contact.title")}
      </h1>
      <p class="mt-3 max-w-md text-paragraph-sm text-neutral-dark-50">
        {t("contact.subtitle")}
      </p>

      <div
        id="contact-success"
        class="mt-8 hidden space-y-3 py-6"
        role="status"
        aria-live="polite"
        tabindex="-1"
      >
        <div
          class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-light-40 text-blue-50"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <h3 class="font-poppins text-label-sm font-bold">
          {t("contact.form.success.title")}
        </h3>
        <p class="text-paragraph-sm text-neutral-dark-50">
          {t("contact.form.success.description")}
        </p>
      </div>

      <form
        id="contact-form"
        class="mt-8 space-y-4"
        data-submitting-label={t("contact.form.submitting")}
        data-error-label={t("contact.form.error")}
        data-validation-label={t("contact.form.validationError")}
      >
        <div>
          <label
            for="contact-name"
            class="mb-1.5 block text-label-sm font-bold text-neutral-dark-10"
          >
            {t("contact.form.name.label")}
          </label>
          <input
            id="contact-name"
            type="text"
            name="name"
            required
            minlength="2"
            maxlength="200"
            placeholder={t("contact.form.name.placeholder")}
            class={inputClass}
          />
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label
              for="contact-email"
              class="mb-1.5 block text-label-sm font-bold text-neutral-dark-10"
            >
              {t("contact.form.email.label")}
            </label>
            <input
              id="contact-email"
              type="email"
              name="email"
              required
              maxlength="200"
              placeholder={t("contact.form.email.placeholder")}
              class={inputClass}
            />
          </div>
          <div>
            <label
              for="contact-phone"
              class="mb-1.5 block text-label-sm font-bold text-neutral-dark-10"
            >
              {t("contact.form.phone.label")}
            </label>
            <input
              id="contact-phone"
              type="tel"
              name="phone"
              maxlength="50"
              placeholder={t("contact.form.phone.placeholder")}
              class={inputClass}
            />
          </div>
        </div>

        <div>
          <label
            for="contact-message"
            class="mb-1.5 block text-label-sm font-bold text-neutral-dark-10"
          >
            {t("contact.form.message.label")}
          </label>
          <textarea
            id="contact-message"
            name="message"
            required
            maxlength="5000"
            rows="4"
            placeholder={t("contact.form.message.placeholder")}
            class={`${inputClass} resize-none`}></textarea>
        </div>

        <div class="hidden" aria-hidden="true">
          <label for="contact-website">Website</label>
          <input
            id="contact-website"
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <p
          id="contact-error"
          class="hidden text-paragraph-sm text-red-600"
          role="alert"
          aria-live="assertive"
          tabindex="-1"
        >
        </p>

        <button
          type="submit"
          class="rounded-full bg-gradient-to-r from-blue-50 to-blue-60 px-8 py-3 text-label-sm font-bold text-white shadow-md shadow-blue-50/30 transition-transform hover:scale-[1.02] disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:scale-100"
        >
          {t("contact.form.submit")}
        </button>
      </form>
    </div>

    <div class="flex flex-col">
      <div
        class="relative mx-auto hidden w-full max-w-[320px] overflow-hidden rounded-2xl shadow-lg md:block"
      >
        <video
          src="/animations/contact.webm"
          class="w-full"
          autoplay
          loop
          muted
          playsinline
          preload="auto"
          aria-hidden="true"
        >
        </video>
      </div>

      <ul class="mt-2 space-y-4 md:mt-8">
        {
          infoItems.map(item => (
            <li class="flex items-center gap-3">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-light-40 text-blue-50">
                <Icon name={item.icon} class="h-4 w-4" />
              </span>
              {item.href ? (
                <a
                  href={item.href}
                  class="text-paragraph-sm text-neutral-dark-50 hover:text-blue-50"
                >
                  {item.value}
                </a>
              ) : (
                <span class="text-paragraph-sm text-neutral-dark-50">
                  {item.value}
                </span>
              )}
            </li>
          ))
        }
        <li class="flex items-center gap-3">
          <span
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-blue-light-40 text-blue-50"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <circle cx="12" cy="12" r="9" stroke-width="2"></circle>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 7v5l3 3"></path>
            </svg>
          </span>
          <span class="text-paragraph-sm text-neutral-dark-50">
            {t("contact.hours.description")}
          </span>
        </li>
      </ul>

      {
        socials.length > 0 && (
          <div class="mt-6 flex gap-3">
            {socials.map(([key, social]) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-10 w-10 items-center justify-center rounded-full text-white transition-transform hover:scale-105"
                style={`background-color: ${socialBrandColor[key] ?? "#1090C7"}`}
              >
                <span class="sr-only">{social.linkTitle}</span>
                <Icon name={key} class="h-4 w-4" />
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</div>

<script>
  import { actions } from "astro:actions";

  const form = document.getElementById(
    "contact-form"
  ) as HTMLFormElement | null;
  const successMessage = document.getElementById("contact-success");
  const errorMessage = document.getElementById("contact-error");
  const submitButton = form?.querySelector(
    'button[type="submit"]'
  ) as HTMLButtonElement | null;
  const submittingLabel = form?.dataset.submittingLabel;
  const genericErrorLabel = form?.dataset.errorLabel ?? "";
  const validationErrorLabel = form?.dataset.validationLabel ?? "";
  let submitting = false;

  form?.addEventListener("submit", async event => {
    event.preventDefault();
    if (!submitButton || submitting) return;

    submitting = true;
    const originalLabel = submitButton.textContent;
    errorMessage?.classList.add("hidden");
    submitButton.disabled = true;
    form.setAttribute("aria-busy", "true");
    if (submittingLabel) submitButton.textContent = submittingLabel;

    try {
      const formData = new FormData(form);
      const { data, error } = await actions.submitContact(formData);

      if (data?.success) {
        form.reset();
        form.classList.add("hidden");
        successMessage?.classList.remove("hidden");
        successMessage?.focus();
      } else if (error) {
        if (errorMessage) {
          errorMessage.textContent =
            error.code === "BAD_REQUEST"
              ? validationErrorLabel
              : genericErrorLabel;
          errorMessage.classList.remove("hidden");
          errorMessage.focus();
        }
      }
    } catch {
      if (errorMessage) {
        errorMessage.textContent = genericErrorLabel;
        errorMessage.classList.remove("hidden");
        errorMessage.focus();
      }
    } finally {
      submitting = false;
      form.removeAttribute("aria-busy");
      submitButton.disabled = false;
      submitButton.textContent = originalLabel;
    }
  });
</script>
