---
import { Icon } from "astro-icon/components";
import HeaderLink from "./header-link.astro";
import { Image } from "astro:assets";
import LogoMark from "@/assets/brand/logo-mark.png";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  useTranslations,
  getOtherLocale,
  getAlternateLocaleHref,
} from "@/i18n/utils";

const lang = Astro.currentLocale;
const t = useTranslations(lang);
const otherLocale = getOtherLocale(lang);
const langSwitchHref = getAlternateLocaleHref(Astro.url.pathname, otherLocale);

const navItems = [
  { label: t("nav.home"), href: getRelativeLocaleUrl(lang ?? "fr", "/") },
  {
    label: t("nav.services"),
    href: getRelativeLocaleUrl(lang ?? "fr", "/services"),
  },
  { label: t("nav.blog"), href: getRelativeLocaleUrl(lang ?? "fr", "/blog") },
  {
    label: t("nav.about"),
    href: getRelativeLocaleUrl(lang ?? "fr", "/about"),
  },
  {
    label: t("nav.contact"),
    href: getRelativeLocaleUrl(lang ?? "fr", "/contact"),
  },
];
---

<header class="relative z-[99] w-full bg-transparent py-2 pt-3 md:py-8 md:pt-8">
  <div class="main flex items-center justify-between">
    <a
      href={getRelativeLocaleUrl(lang ?? "fr", "/")}
      class="z-10"
      aria-label="Neurovex Technologies">
      <div
        class="flex cursor-pointer items-center gap-2 whitespace-nowrap font-sans text-2xl font-black"
      >
        <Image
          src={LogoMark}
          alt=""
          width={40}
          height={40}
          class="w-[32px] md:w-[40px]"
        />
        <span class="text-[20px] tracking-tight text-neutral-dark-10 md:text-[24px]"
          >NEUROVEX</span
        >
      </div>
    </a>
    <div class="md:hidden">
      <input type="checkbox" id="navbar-open" class="peer hidden" />
      <label
        for="navbar-open"
        class="group relative z-20 cursor-pointer peer-checked:fixed peer-checked:right-4 peer-checked:top-4"
        aria-label="Toggle Navigation"
      >
        <span class="sr-only">Toggle Navigation</span>
        <div
          class="rounded-lg border-2 border-black p-1 group-[.peer:checked+&]:-ml-1 group-[.peer:checked+&]:mt-1"
        >
          <Icon name="menu" class="h-6 w-6 group-[.peer:checked+&]:hidden" />
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="hidden h-6 w-6 group-[.peer:checked+&]:block"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </div>
      </label>

      <nav
        aria-label="Header Navigation"
        class="fixed inset-0 z-10 flex translate-x-full transform items-center justify-center bg-white transition-transform duration-300 ease-in-out peer-checked:translate-x-0"
      >
        <ul class="flex flex-col items-center space-y-6 text-lg">
          {
            navItems.map(item => (
              <li>
                <HeaderLink label={item.label} href={item.href} />
              </li>
            ))
          }
          <li>
            <a
              href={langSwitchHref}
              class="rounded-md border border-neutral-dark-10 px-3 py-1 text-label-sm font-bold text-neutral-dark-10"
            >
              {t("nav.langSwitch")}
            </a>
          </li>
        </ul>
      </nav>
    </div>

    <nav
      aria-label="Header Navigation"
      class="b hidden flex-1 flex-row items-center justify-between md:flex lg:pl-12"
    >
      <div></div>
      <ul class="flex flex-row items-center space-x-0.5 lg:space-x-3">
        {
          navItems.map(item => (
            <li>
              <HeaderLink label={item.label} href={item.href} />
            </li>
          ))
        }
      </ul>
      <a
        href={langSwitchHref}
        class="rounded-md border border-neutral-dark-10 px-2.5 py-1 text-label-sm font-bold text-neutral-dark-10 hover:bg-neutral-dark-10 hover:text-white"
        aria-label="Switch language"
      >
        {t("nav.langSwitch")}
      </a>
    </nav>
  </div>
</header>
