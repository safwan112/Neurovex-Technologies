---
import { Icon } from "astro-icon/components";
import { getAlternateLocaleHref } from "@/i18n/utils";

export interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const lang = Astro.currentLocale === "en" ? "en" : "fr";

const locales = [
  { code: "fr" as const, label: "Français", flag: "flag-fr" },
  { code: "en" as const, label: "English", flag: "flag-en" },
];

const current = locales.find(l => l.code === lang)!;
const hrefFor = (code: "en" | "fr") =>
  getAlternateLocaleHref(Astro.url.pathname, code);
---

<details class={`lang-switch group relative ${className}`}>
  <summary
    class="flex cursor-pointer list-none items-center gap-2 rounded-full border border-neutral-dark-10/30 px-3 py-1.5 outline-none"
    aria-label="Switch language"
  >
    <span class="relative inline-flex h-4 w-[21px] shrink-0 overflow-hidden rounded-[2px]">
      <Icon name={current.flag} class="h-full w-full" />
    </span>
    <span class="text-label-sm font-bold text-neutral-dark-10">
      {current.code.toUpperCase()}
    </span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-3.5 w-3.5 shrink-0 text-neutral-dark-10 transition-transform duration-200 group-open:rotate-180"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2.5"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
    </svg>
  </summary>

  <ul
    class="absolute right-0 z-20 mt-2 min-w-[9rem] overflow-hidden rounded-xl border border-neutral-dark-10/15 bg-white py-1 shadow-lg"
  >
    {
      locales.map(l => (
        <li>
          <a
            href={hrefFor(l.code)}
            class={`flex items-center gap-2.5 px-3 py-2 text-label-sm font-semibold transition-colors hover:bg-neutral-dark-10/5 ${
              l.code === current.code
                ? "text-neutral-dark-10"
                : "text-neutral-dark-10/60"
            }`}
            aria-current={l.code === current.code ? "true" : undefined}
          >
            <span class="relative inline-flex h-4 w-[21px] shrink-0 overflow-hidden rounded-[2px]">
              <Icon name={l.flag} class="h-full w-full" />
            </span>
            {l.label}
            {l.code === current.code && (
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="ml-auto h-4 w-4 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang-switch > summary::-webkit-details-marker {
    display: none;
  }
</style>

<script>
  document.addEventListener("click", event => {
    const target = event.target as Node;
    document.querySelectorAll<HTMLDetailsElement>(".lang-switch[open]").forEach(el => {
      if (!el.contains(target)) el.removeAttribute("open");
    });
  });

  document.querySelectorAll<HTMLDetailsElement>(".lang-switch").forEach(el => {
    el.addEventListener("toggle", () => {
      if (!el.open) return;
      document.querySelectorAll<HTMLDetailsElement>(".lang-switch[open]").forEach(other => {
        if (other !== el) other.removeAttribute("open");
      });
    });
  });
</script>
