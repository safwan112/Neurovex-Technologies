---
import type { ProjectType } from "./project-item.astro";
import ProjectItem from "./project-item.astro";
import RiveAnimationScript from "@/components/rive-animation-script.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n/utils";

const lang = Astro.currentLocale ?? "fr";
const t = useTranslations(lang);
const servicesHref = getRelativeLocaleUrl(lang, "/services");

const services: ProjectType[] = t("services.items").map(service => ({
  title: service.title,
  description: service.description,
  video: service.video,
  links: [{ text: t("services.learnMore"), url: `${servicesHref}#${service.id}` }],
  color: service.color,
}));
---

<section class="py-16" id="services">
  <div class="main mx-auto px-4">
    <div class="mb-8 flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-center">
      <h2 class="text-heading-sm font-bold">{t("services.heading")}</h2>
      <a
        href={servicesHref}
        class="flex items-center gap-1 text-label-sm font-bold text-neutral-dark-10 hover:text-neutral-dark-20"
      >
        {t("services.seeAll")}
      </a>
    </div>
    <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
      {services.map(service => <ProjectItem project={service} />)}
    </div>
  </div>
</section>
<RiveAnimationScript />
