---
import type { ProjectType } from "./project-item.astro";
import ProjectItem from "./project-item.astro";
import RiveAnimationScript from "@/components/rive-animation-script.astro";
const services: ProjectType[] = [
  {
    title: "Solutions Informatique",
    description:
      "Postes de travail, serveurs, infrastructures réseau et sécurité : nous concevons et maintenons un parc informatique fiable et évolutif pour votre entreprise.",
    icon: "server",
    links: [{ text: "En savoir plus", url: "/services#informatique" }],
    color: "#2FAEEA",
  },
  {
    title: "Bureautique & Équipement",
    description:
      "Imprimantes, copieurs et mobilier de bureau technologique : des équipements adaptés à votre activité, livrés et installés avec un service de proximité.",
    icon: "printer",
    links: [{ text: "En savoir plus", url: "/services#bureautique" }],
    color: "#6260E8",
  },
  {
    title: "Télécommunications",
    description:
      "Téléphonie IP, connectivité et infrastructure réseau : nous déployons des solutions de communication performantes et évolutives pour vos équipes.",
    icon: "signal",
    links: [{ text: "En savoir plus", url: "/services#telecommunications" }],
    color: "#292D33",
  },
  {
    title: "Support & Maintenance",
    description:
      "Une assistance technique réactive et des contrats de service sur mesure, pour garantir la continuité de votre activité à tout moment.",
    icon: "wrench",
    links: [{ text: "En savoir plus", url: "/services#support" }],
    color: "#1090C7",
  },
];
---

<section class="py-16" id="services">
  <div class="main mx-auto px-4">
    <div class="mb-8 flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-center">
      <h2 class="text-heading-sm font-bold">Nos services</h2>
      <a
        href="/services"
        class="flex items-center gap-1 text-label-sm font-bold text-neutral-dark-10 hover:text-neutral-dark-20"
      >
        Voir tous nos services →
      </a>
    </div>
    <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
      {services.map(service => <ProjectItem project={service} />)}
    </div>
  </div>
</section>
<RiveAnimationScript />
