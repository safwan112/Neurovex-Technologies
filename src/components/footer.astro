---
import { SOCIALS, COMPANY } from "@/config";
import { Icon } from "astro-icon/components";
import { ButtonLink } from "./button";
import { Image } from "astro:assets";
import LogoMark from "@/assets/brand/logo-mark.png";

const navLinks = [
  { title: "Accueil", href: "/" },
  { title: "Services", href: "/services" },
  { title: "Blog", href: "/blog" },
  { title: "À propos", href: "/about" },
  { title: "Contact", href: "/contact" },
];
---

<footer class="bg-black py-12 text-white" id="footer">
  <div class="main text-neutral-light-30">
    <div class="mb-10 flex flex-col items-start justify-between gap-4 border-b border-neutral-light-0/20 pb-10 md:flex-row md:items-center">
      <h2 class="max-w-lg font-sans text-heading-lg">
        Prêt à démarrer votre transformation numérique&nbsp;?
      </h2>
      <ButtonLink href="/contact" variant="secondary" className="shrink-0">
        Contactez-nous <Icon name="arrow-right" class="ml-2 h-4 w-4" />
      </ButtonLink>
    </div>

    <div class="grid gap-10 font-sans md:grid-cols-3">
      <div class="md:col-span-1">
        <a href="/" class="mb-4 flex items-center gap-2" aria-label="Neurovex Technologies">
          <Image src={LogoMark} alt="" width={36} height={36} class="w-9" />
          <span class="text-lg font-black tracking-tight text-white"
            >NEUROVEX</span
          >
        </a>
        <p class="max-w-xs text-paragraph-sm text-neutral-light-0">
          Votre point de convergence bureautique, informatique et
          télécommunications à Marrakech. Proximité humaine et expertise
          technique au service de votre entreprise.
        </p>
        {
          Object.keys(SOCIALS).length > 0 && (
            <div class="mt-5 flex space-x-5">
              {Object.entries(SOCIALS).map(([key, social]) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-gray-400"
                >
                  <span class="sr-only">{social.linkTitle}</span>
                  <Icon name={key} class="h-5 w-5 text-white" />
                </a>
              ))}
            </div>
          )
        }
      </div>

      <div>
        <h2 class="mb-4 text-heading-sm">Navigation</h2>
        <ul class="space-y-2 font-bold">
          {
            navLinks.map(link => (
              <li>
                <a href={link.href} class="flex w-fit items-center hover:text-white">
                  &gt; {link.title}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="mb-4 text-heading-sm">Contact</h2>
        <ul class="space-y-3 text-paragraph-sm">
          <li class="flex items-start gap-2">
            <Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0" />
            <span>{COMPANY.address}</span>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="phone" class="h-4 w-4 shrink-0" />
            <a href={`tel:${COMPANY.phoneHref}`} class="hover:text-white">
              {COMPANY.phone}
            </a>
          </li>
          <li class="flex items-center gap-2">
            <Icon name="mail" class="h-4 w-4 shrink-0" />
            <a href={`mailto:${COMPANY.email}`} class="hover:text-white">
              {COMPANY.email}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-neutral-light-0/50 pt-8 text-center">
      <p>
        © {new Date().getFullYear()}
        {" "}<a href="/" class="hover:text-white">Neurovex Technologies</a>. Tous
        droits réservés.
      </p>
    </div>
  </div>
</footer>
