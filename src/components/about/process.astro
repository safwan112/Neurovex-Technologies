---
import { useTranslations } from "@/i18n/utils";

const lang = Astro.currentLocale ?? "fr";
const t = useTranslations(lang);
const steps = t("process.steps");
---

<section id="process" class="bg-neutral-dark-20 py-16">
  <div class="main mx-auto">
    <h2 class="mb-2 text-center text-heading-sm text-neutral-light-50 md:text-left">
      {t("process.heading")}
    </h2>
    <p class="mb-10 text-center text-paragraph-sm text-neutral-light-0 md:text-left">
      {t("process.subtitle")}
    </p>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map(step => (
          <div class="rounded-lg border border-neutral-light-0/20 p-6">
            <span class="text-heading-sm font-bold text-blue-60">
              {step.number}
            </span>
            <h3 class="mt-3 text-label-lg font-semibold text-neutral-light-50">
              {step.title}
            </h3>
            <p class="mt-2 text-paragraph-sm text-neutral-light-0">
              {step.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
