---
import type { CollectionEntry } from "astro:content";
import { getReadingTimeLabel } from "@/lib/utils";
import Layout from "@/components/layout.astro";
import { getEntries, render } from "astro:content";
import Header from "@/components/header.astro";
import ShareArticle from "./share-article.astro";
import BlogImage from "./blog-image.astro";
import ArticleNavigation from "./article-navigation.astro";
import PageViews from "./page-views.astro";
import TableOfContents from "./table-of-contents.astro";

export interface Props {
  article: CollectionEntry<"blog">;
}

const { article } = Astro.props;

const { title, description, ogImage, pubDatetime, lang } = article.data;
const pageUrl = new URL(Astro.url.pathname, Astro.url.origin).href;

const readingTime = getReadingTimeLabel(article.body, lang);
const publishedOn = new Intl.DateTimeFormat(lang === "en" ? "en-GB" : "fr-FR", {
  day: "numeric",
  month: "short",
  year: "numeric",
}).format(pubDatetime);
const { Content, headings } = await render(article);
const authors = article.data.authors
  ? await getEntries(article.data.authors)
  : undefined;
---

<Layout
  title={title}
  author={authors?.map(author => author.data.name).join(", ")}
  description={description}
  ogImage={ogImage?.src}
>
  <Header />
  <main id="main-content" class="main mx-auto pb-10">
    <header class="mx-auto max-w-2xl pt-10 md:pt-14">
      <h1
        class="font-sans text-3xl font-bold leading-tight tracking-tight text-neutral-dark-10 md:text-[2.625rem]"
      >
        {title}
      </h1>
      {
        description && (
          <p class="mt-4 font-sans text-lg leading-relaxed text-neutral-dark-50 md:text-xl">
            {description}
          </p>
        )
      }

      <div class="mt-8 flex items-center gap-3">
        {
          authors?.[0] && (
            <img
              src={authors[0].data.avatar}
              alt=""
              width="44"
              height="44"
              class="h-11 w-11 rounded-full bg-white object-cover ring-1 ring-neutral-dark-10/10"
            />
          )
        }
        <div class="font-sans">
          <p class="text-[0.95rem] font-semibold text-neutral-dark-10">
            {
              authors?.map((author, index) => (
                <>
                  {index > 0 && ", "}
                  <a
                    href={author.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline"
                  >
                    {author.data.name}
                  </a>
                </>
              ))
            }
          </p>
          <p class="mt-0.5 text-sm text-neutral-dark-50">
            <span>{readingTime}</span>
            <span class="px-1.5" aria-hidden="true">·</span>
            <time datetime={pubDatetime.toISOString()}>{publishedOn}</time>
          </p>
        </div>
      </div>
      <PageViews url={pageUrl} />

      <div class="mt-8 border-t border-neutral-dark-10/10"></div>
      {
        ogImage && (
          <div class="mt-8 overflow-hidden rounded-2xl">
            <BlogImage
              slug={article.data.slug}
              title={title}
              ogImage={ogImage}
            />
          </div>
        )
      }
    </header>

    <div class="relative mx-auto max-w-2xl">
      <article
        id="article"
        role="article"
        class="prose prose-lg mx-auto mt-10 max-w-none prose-headings:tracking-tight prose-p:leading-8"
      >
        <Content />
      </article>
      <TableOfContents headings={headings} />
    </div>
    <ShareArticle />
    <ArticleNavigation article={article} />
  </main>
</Layout>

<style>
  body {
    @apply bg-[#F2F4F7];
  }
</style>
