---
import { getCollection } from "astro:content";
import { getArticlesByLocale } from "@/lib/utils";
import CardHomePage from "./blog-card-home-page.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n/utils";

const lang = Astro.currentLocale ?? "fr";
const t = useTranslations(lang);
const articles = await getCollection("blog");

const latestArticles = getArticlesByLocale(articles, lang).slice(0, 3);
---

<section class="bg-[#F2F4F7] py-16">
  <div class="main mx-auto px-4">
    <h2 class="mb-6 text-3xl font-bold">{t("blog.title")}</h2>
    <div
      class="grid grid-cols-1 divide-[#C3CAD4]/50 md:grid-cols-2 md:divide-x-2 lg:grid-cols-3"
    >
      {
        latestArticles.map(article => (
          <CardHomePage
            frontmatter={article.data}
            href={getRelativeLocaleUrl(lang, `/blog/${article.data.slug}`)}
          />
        ))
      }
    </div>
  </div>
</section>
