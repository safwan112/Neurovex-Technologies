---
import type { CollectionEntry } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import BlogImage from "./blog-image.astro";
import { ButtonLink } from "@/components/button";

export interface Props {
  pageNum: number;
  totalPages: number;
  articles: CollectionEntry<"blog">[];
}

const { pageNum, totalPages, articles } = Astro.props;
const lang = Astro.currentLocale === "en" ? "en" : "fr";
const en = lang === "en";
const cards = pageNum === 1 ? articles.slice(1) : articles;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(en ? "en-GB" : "fr-FR", {
    day: "numeric",
    month: "short",
    year: "numeric",
  }).format(date);
---

<section class="main mx-auto pb-20 md:pb-28" aria-labelledby="articles-title">
  <div
    class="mb-8 flex flex-wrap items-end justify-between gap-4 border-b border-neutral-dark-10/15 pb-5 md:mb-10"
  >
    <div>
      <p
        class="mb-2 font-sans text-xs font-bold uppercase tracking-[0.2em] text-blue-60"
      >
        {en ? "Explore" : "À explorer"}
      </p>
      <h2
        id="articles-title"
        class="font-sans text-3xl font-semibold tracking-tight text-neutral-dark-10 md:text-4xl"
      >
        {en ? "All articles" : "Tous les articles"}
      </h2>
    </div>
    <p class="font-sans text-sm text-neutral-dark-50">
      {cards.length}
      {en ? "articles on this page" : "articles sur cette page"}
    </p>
  </div>
  <div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">
    {
      cards.map(article => (
        <a
          href={getRelativeLocaleUrl(lang, `/blog/${article.data.slug}`)}
          class="group flex flex-col overflow-hidden rounded-2xl border border-neutral-dark-10/10 bg-white shadow-[0_12px_35px_-28px_rgba(12,31,49,0.45)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_25px_45px_-30px_rgba(12,31,49,0.45)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blue-60"
        >
          <div class="aspect-[16/10] overflow-hidden">
            <BlogImage
              slug={article.data.slug}
              title={article.data.title}
              ogImage={article.data.ogImage}
            />
          </div>
          <div class="flex flex-1 flex-col p-6 md:p-7">
            <p class="font-sans text-xs font-semibold uppercase tracking-[0.13em] text-blue-60">
              {formatDate(article.data.pubDatetime)}
            </p>
            <h3 class="mt-3 font-sans text-xl font-semibold leading-snug tracking-tight text-neutral-dark-10 md:text-[1.4rem]">
              {article.data.title}
            </h3>
            <p class="mt-3 line-clamp-3 font-sans text-sm leading-relaxed text-neutral-dark-50">
              {article.data.description}
            </p>
            <span class="mt-auto flex items-center gap-2 pt-7 font-sans text-sm font-semibold text-neutral-dark-10">
              {en ? "Read article" : "Lire l’article"}
              <span
                class="text-lg transition-transform group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </span>
          </div>
        </a>
      ))
    }
  </div>
  {
    totalPages > 1 && (
      <nav
        class="mt-12 flex justify-center gap-4"
        aria-label={en ? "Pagination" : "Pagination des articles"}
      >
        {pageNum > 1 && (
          <ButtonLink
            href={getRelativeLocaleUrl(
              lang,
              pageNum === 2 ? "/blog" : `/blog/${pageNum - 1}`
            )}
            variant="ghost"
          >
            {en ? "Previous" : "Précédent"}
          </ButtonLink>
        )}
        {pageNum < totalPages && (
          <ButtonLink
            href={getRelativeLocaleUrl(lang, `/blog/${pageNum + 1}`)}
            variant="ghost"
          >
            {en ? "Next" : "Suivant"}
          </ButtonLink>
        )}
      </nav>
    )
  }
</section>
