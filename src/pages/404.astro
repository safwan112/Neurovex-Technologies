---
import Layout from "@/components/layout.astro";
import Header from "@/components/header.astro";

const title = "404 | Neurovex Technologies";
const description = "Cette page n'existe pas.";
---

<Layout title={title} description={description}>
  <Header />
  <main class="flex min-h-[60vh] flex-col items-center justify-center px-4">
    <h1 class="text-primary mb-4 text-6xl font-bold">404</h1>
    <p class="mb-8 text-center text-2xl text-gray-600 dark:text-gray-400">
      Cette page n'existe pas. Le lien suivi est peut-être obsolète ou l'URL
      est incorrecte.
    </p>
    <a
      href="/"
      class="hover:bg-primary/90 rounded-lg px-6 py-3 text-gray-900 transition-colors duration-200"
    >
      Retour à l'accueil
    </a>
  </main>
</Layout>
