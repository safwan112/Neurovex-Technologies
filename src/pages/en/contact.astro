---
import { SITE, COMPANY } from "@/config";
import Layout from "@/components/layout.astro";
import Header from "@/components/header.astro";
import { Icon } from "astro-icon/components";
import { useTranslations } from "@/i18n/utils";

const lang = Astro.currentLocale ?? "fr";
const t = useTranslations(lang);

const contactCards = [
  {
    icon: "map-pin",
    title: t("contact.card.address"),
    value: COMPANY.address,
    href: undefined,
  },
  {
    icon: "phone",
    title: t("contact.card.phone"),
    value: COMPANY.phone,
    href: `tel:${COMPANY.phoneHref}`,
  },
  {
    icon: "mail",
    title: t("contact.card.email"),
    value: COMPANY.email,
    href: `mailto:${COMPANY.email}`,
  },
];
---

<Layout title={`Contact | ${SITE.title}`} description={t("contact.meta.description")}>
  <section class="relative overflow-hidden bg-[#DCEFFB]">
    <Header />
    <div class="main relative z-10 mx-auto pb-16 pt-2 md:pb-24 md:pt-16">
      <h1 class="max-w-2xl text-center font-sans text-3xl font-extrabold md:text-left md:text-title">
        {t("contact.title")}
      </h1>
      <p class="text-md my-4 max-w-[600px] text-center font-sans font-thin md:my-8 md:text-left md:text-label-sm">
        {t("contact.subtitle")}
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="main mx-auto px-4">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        {
          contactCards.map(card => (
            <div class="flex flex-col items-start gap-3 rounded-lg border border-neutral-light-0 bg-white p-6">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-light-40 text-blue-50">
                <Icon name={card.icon} class="h-5 w-5" />
              </div>
              <h2 class="text-label-sm font-bold">{card.title}</h2>
              {card.href ? (
                <a href={card.href} class="text-paragraph-sm text-neutral-dark-50 hover:text-blue-50">
                  {card.value}
                </a>
              ) : (
                <p class="text-paragraph-sm text-neutral-dark-50">{card.value}</p>
              )}
            </div>
          ))
        }
      </div>

      <div class="mt-12 max-w-2xl">
        <h2 class="text-heading-sm font-bold">{t("contact.hours.heading")}</h2>
        <p class="mt-3 text-paragraph-lg text-neutral-dark-50">
          {t("contact.hours.description")}
        </p>
      </div>
    </div>
  </section>
</Layout>
