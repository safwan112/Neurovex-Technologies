---
import Layout from "@/components/layout.astro";
import { isAuthenticated, loginRedirect } from "./auth";

// Dev-only page (injected by the dev-admin integration in astro.config.mjs).
export const prerender = false;

if (!isAuthenticated(Astro.cookies)) {
  return Astro.redirect(loginRedirect("/admin/new-article"));
}

const today = new Date().toISOString().slice(0, 10);

const inputClass =
  "w-full rounded-xl border border-transparent bg-blue-light-50 px-4 py-3 text-paragraph-sm text-neutral-dark-50 placeholder:text-neutral-dark-10/40 transition-colors focus:border-blue-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-50/20";
const labelClass = "mb-1.5 block text-label-sm font-bold text-neutral-dark-10";
const cardClass =
  "rounded-[2rem] bg-white p-6 shadow-xl shadow-blue-10/10 sm:p-8 md:p-10";

const languages = [
  {
    code: "fr",
    heading: "Français",
    note: "Obligatoire",
    placeholders: {
      title: "Ex. : Sécuriser le Wi-Fi de son entreprise",
      description: "Une ou deux phrases affichées sur la carte de l'article.",
      tags: "IA, entreprise, Neurovex",
      keywords: "intelligence artificielle, PME, Marrakech",
    },
  },
  {
    code: "en",
    heading: "English",
    note: "Facultatif : laissez vide pour publier en français seulement",
    placeholders: {
      title: "E.g. Securing your company Wi-Fi",
      description: "One or two sentences shown on the article card.",
      tags: "AI, entreprise, Neurovex",
      keywords: "artificial intelligence, SME, Marrakech",
    },
  },
];
---

<Layout title="Nouvel article | Admin">
  <main
    class="min-h-screen bg-gradient-to-br from-blue-light-50 via-blue-light-40 to-blue-light-20 py-12 font-poppins md:py-16"
  >
    <div class="main mx-auto max-w-4xl">
      <a
        href="/admin"
        class="text-label-sm font-bold text-blue-60 hover:text-blue-50"
      >
        ← Tous les articles
      </a>
      <h1
        class="mt-4 text-3xl font-bold text-neutral-dark-10 md:text-heading-sm"
      >
        Nouvel article
      </h1>

      <div
        id="article-success"
        class="mt-8 hidden rounded-2xl bg-white p-6 shadow-lg"
        role="status"
        aria-live="polite"
        tabindex="-1"
      >
        <p class="text-label-sm font-bold text-neutral-dark-10">
          Article enregistré dans <code id="article-folder"></code>
        </p>
        <ul id="article-links" class="mt-3 space-y-1 text-paragraph-sm"></ul>
        <button
          type="button"
          id="article-new"
          class="mt-4 text-label-sm font-bold text-blue-60 hover:text-blue-50"
        >
          Écrire un autre article
        </button>
      </div>

      <form id="article-form" class="mt-8 space-y-6">
        <section class={cardClass}>
          <h2 class="mb-6 text-xl font-bold text-neutral-dark-10">Général</h2>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label for="date" class={labelClass}>Date de publication</label>
              <input
                id="date"
                type="date"
                name="date"
                required
                value={today}
                class={inputClass}
              />
            </div>
            <div>
              <label for="author-name" class={labelClass}>Auteur</label>
              <input
                id="author-name"
                type="text"
                value="Neurovex Technologies"
                readonly
                class={`${inputClass} cursor-default`}
              />
              <input type="hidden" name="author" value="neurovex" />
            </div>
            <div>
              <label for="slug" class={labelClass}>Adresse (slug)</label>
              <input
                id="slug"
                type="text"
                name="slug"
                required
                pattern="[a-z0-9]+(-[a-z0-9]+)*"
                placeholder="rempli automatiquement depuis le titre"
                class={inputClass}
              />
              <p class="mt-1 text-xs text-neutral-dark-50">
                L'article sera visible sur <code
                  >/blog/<span id="slug-preview">…</span></code
                >
              </p>
            </div>
            <div>
              <label for="cover" class={labelClass}>
                Image de couverture (facultatif)
              </label>
              <input
                id="cover"
                type="file"
                name="cover"
                accept="image/png,image/jpeg,image/webp"
                class={`${inputClass} file:mr-3 file:rounded-full file:border-0 file:bg-blue-50 file:px-3 file:py-1 file:text-xs file:font-bold file:text-white`}
              />
              <p class="mt-1 text-xs text-neutral-dark-50">
                PNG, JPG ou WebP, 5 Mo maximum. Sans image, la carte garde le
                visuel Neurovex.
              </p>
            </div>
          </div>
        </section>

        {
          languages.map(language => (
            <section class={cardClass}>
              <div class="mb-6 flex flex-wrap items-baseline justify-between gap-2">
                <h2 class="text-xl font-bold text-neutral-dark-10">
                  {language.heading}
                </h2>
                <span class="text-xs text-neutral-dark-50">
                  {language.note}
                </span>
              </div>
              <div class="space-y-4">
                <div>
                  <label for={`${language.code}-title`} class={labelClass}>
                    Titre
                  </label>
                  <input
                    id={`${language.code}-title`}
                    type="text"
                    name={`${language.code}-title`}
                    required={language.code === "fr"}
                    maxlength="160"
                    placeholder={language.placeholders.title}
                    class={inputClass}
                  />
                </div>
                <div>
                  <label
                    for={`${language.code}-description`}
                    class={labelClass}
                  >
                    Description
                  </label>
                  <textarea
                    id={`${language.code}-description`}
                    name={`${language.code}-description`}
                    required={language.code === "fr"}
                    rows="2"
                    maxlength="300"
                    placeholder={language.placeholders.description}
                    class={`${inputClass} resize-none`}
                  />
                </div>
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                  <div>
                    <label for={`${language.code}-tags`} class={labelClass}>
                      Tags (séparés par des virgules)
                    </label>
                    <input
                      id={`${language.code}-tags`}
                      type="text"
                      name={`${language.code}-tags`}
                      placeholder={language.placeholders.tags}
                      class={inputClass}
                    />
                  </div>
                  <div>
                    <label for={`${language.code}-keywords`} class={labelClass}>
                      Mots-clés SEO (séparés par des virgules)
                    </label>
                    <input
                      id={`${language.code}-keywords`}
                      type="text"
                      name={`${language.code}-keywords`}
                      placeholder={language.placeholders.keywords}
                      class={inputClass}
                    />
                  </div>
                </div>
                <div>
                  <label for={`${language.code}-body`} class={labelClass}>
                    Contenu (Markdown)
                  </label>
                  <textarea
                    id={`${language.code}-body`}
                    name={`${language.code}-body`}
                    required={language.code === "fr"}
                    rows="16"
                    placeholder={
                      "Paragraphe d'introduction.\n\n## Titre de section\n\nTexte avec **gras** et un [lien](/services#informatique)."
                    }
                    class={`${inputClass} font-mono`}
                  />
                </div>
              </div>
            </section>
          ))
        }

        <div class={`${cardClass} text-paragraph-sm text-neutral-dark-50`}>
          <p class="font-bold text-neutral-dark-10">Aide Markdown</p>
          <ul class="mt-2 space-y-1">
            <li><code>## Titre</code> : titre de section</li>
            <li><code>**texte**</code> : gras</li>
            <li><code>- élément</code> : liste à puces</li>
            <li>
              <code>[texte](/services#informatique)</code> : lien (ancres : informatique,
              support, telecommunications, bureautique)
            </li>
          </ul>
        </div>

        <p
          id="article-error"
          class="hidden rounded-xl bg-red-50 p-4 text-paragraph-sm text-red-600"
          role="alert"
          tabindex="-1"
        >
        </p>

        <button
          type="submit"
          class="rounded-full bg-gradient-to-r from-blue-50 to-blue-60 px-8 py-3 text-label-sm font-bold text-white shadow-md shadow-blue-50/30 transition-transform hover:scale-[1.02] disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:scale-100"
        >
          Enregistrer l'article
        </button>
      </form>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById(
    "article-form"
  ) as HTMLFormElement | null;
  const titleInput = document.getElementById(
    "fr-title"
  ) as HTMLInputElement | null;
  const slugInput = document.getElementById("slug") as HTMLInputElement | null;
  const slugPreview = document.getElementById("slug-preview");
  const errorMessage = document.getElementById("article-error");
  const success = document.getElementById("article-success");
  const successFolder = document.getElementById("article-folder");
  const successLinks = document.getElementById("article-links");
  const newButton = document.getElementById("article-new");
  const submitButton = form?.querySelector(
    'button[type="submit"]'
  ) as HTMLButtonElement | null;

  let slugEdited = false;

  const slugify = (value: string) =>
    value
      .normalize("NFD")
      .replace(/[̀-ͯ]/g, "")
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");

  const updatePreview = () => {
    if (slugPreview) slugPreview.textContent = slugInput?.value || "…";
  };

  titleInput?.addEventListener("input", () => {
    if (!slugEdited && slugInput) {
      slugInput.value = slugify(titleInput.value);
      updatePreview();
    }
  });

  slugInput?.addEventListener("input", () => {
    slugEdited = slugInput.value.length > 0;
    updatePreview();
  });

  const showError = (message: string) => {
    if (!errorMessage) return;
    errorMessage.textContent = message;
    errorMessage.classList.remove("hidden");
    errorMessage.focus();
  };

  form?.addEventListener("submit", async event => {
    event.preventDefault();
    if (!submitButton) return;

    errorMessage?.classList.add("hidden");
    submitButton.disabled = true;
    const originalLabel = submitButton.textContent;
    submitButton.textContent = "Enregistrement…";

    try {
      const response = await fetch("/api/admin/articles", {
        method: "POST",
        body: new FormData(form),
      });
      const result = await response.json();

      if (!response.ok) {
        showError(result.error ?? "L'enregistrement a échoué.");
        return;
      }

      if (successFolder) successFolder.textContent = result.folder;
      if (successLinks) {
        successLinks.replaceChildren(
          ...result.links.map((href: string) => {
            const item = document.createElement("li");
            const link = document.createElement("a");
            link.href = href;
            link.textContent = `Voir l'article : ${href}`;
            link.className = "text-blue-60 underline hover:text-blue-50";
            item.append(link);
            return item;
          })
        );
      }
      form.classList.add("hidden");
      success?.classList.remove("hidden");
      success?.focus();
    } catch {
      showError(
        "Impossible de contacter le serveur. Est-ce que pnpm dev tourne ?"
      );
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = originalLabel;
    }
  });

  newButton?.addEventListener("click", () => {
    form?.reset();
    slugEdited = false;
    updatePreview();
    success?.classList.add("hidden");
    form?.classList.remove("hidden");
    window.scrollTo({ top: 0 });
  });
</script>
